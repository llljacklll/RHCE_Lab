# ============================================================
#  RHCE LAB — .gitignore
# ------------------------------------------------------------
#  Regla de oro: al repositorio SOLO sube lo que un alumno
#  necesita tras hacer 'git clone'. El estado de sesión, los
#  logs y los secretos en claro, fuera.
# ============================================================

# --- Estado del laboratorio (se regenera solo) --------------
state/current_exam.yml
state/exam_status.yml
state/timer.pid

# --- Logs de corrección (histórico local) --------------------
#  Se ignora el contenido PERO se conserva .gitkeep para que
#  la carpeta exista tras el clone.
state/results/*
!state/results/.gitkeep

# --- Vault: jamás subir la contraseña en claro ---------------
ansible/files/.vault_pass

# --- Python ---------------------------------------------------
__pycache__/
*.pyc

# --- OS / editores --------------------------------------------
.DS_Store
Thumbs.db
*.swp
webui/run.log
webui/__pycache__/

# --- Placeholders del Generar (webui): 0 bytes, regenerables, fuera ---
ansible/playbooks/med_user_app.yml
ansible/playbooks/medium_fcontext_web.yml
ansible/playbooks/rand_pkg_httpd.yml
ansible/playbooks/rand_pkg_mariadb.yml
ansible/playbooks/rand_user_webmaster.yml
